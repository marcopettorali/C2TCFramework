{  
    "xavier": "8x2=16GHz",
    "rpi": "4x2.4 = 9.6GHz",
    "fog": "32 GHz",
    "cloud":"16*4=64GHz",
    
    "environment": "environments/env1_urbsense.json",
    "deployment": "deployments/env1_urbsense.json",

    "applications_import": "apps_urbsense.json",

    "processes_array": {
        "name": [ "A0", "A1", "A2", "A3", "A4", "A5", "A6", "A7" ],
        "application": [ "A0", "A1", "A2", "A3", "A4", "A5", "A6", "A7" ],
        "mns": [ 1, 1, 1, 1, 1, 1, 1, 1 ],
        "max_delay_ms": [ 200, 500, 1000, 1500, 2000, 4000, 6000, 8000 ],
        "execution_times": [50, 125, 250, 375, 500, 1000, 1500, 2000],
        "min_reliability": [ 0, 0, 0, 0, 0, 0, 0, 0 ],
        "aoi": [
            { "type": "circle", "data": [ [ 100,100 ], 200 ] },
            { "type": "circle", "data": [ [ 100,100 ], 200 ] },
            { "type": "circle", "data": [ [ 100,100 ], 200 ] },
            { "type": "circle", "data": [ [ 100,100 ], 200 ] },
            { "type": "circle", "data": [ [ 100,100 ], 200 ] },
            { "type": "circle", "data": [ [ 100,100 ], 200 ] },
            { "type": "circle", "data": [ [ 100,100 ], 200 ] },
            { "type": "circle", "data": [ [ 100,100 ], 200 ] }
        ]
    },

    "topology": {
        "agents": {
            "A0": { "type": "process" },
            "A1": { "type": "process" },
            "A2": { "type": "process" },
            "A3": { "type": "process" },
            "A4": { "type": "process" },
            "A5": { "type": "process" },
            "A6": { "type": "process" },
            "A7": { "type": "process" },
            "AP0": { "type": "host", "cpu_ghz": 1, "ram_gb": "inf", "infinite_parallelism": false, "qtime_dist_function": "resourceallocation.urbsense.urbsense.qtime(period_seconds=8)" },
            "AP1": { "type": "host", "cpu_ghz": 1, "ram_gb": "inf", "infinite_parallelism": false, "qtime_dist_function": "resourceallocation.urbsense.urbsense.qtime(period_seconds=8)" },
            "AP2": { "type": "host", "cpu_ghz": 1, "ram_gb": "inf", "infinite_parallelism": false, "qtime_dist_function": "resourceallocation.urbsense.urbsense.qtime(period_seconds=8)" },
            "AP3": { "type": "host", "cpu_ghz": 1, "ram_gb": "inf", "infinite_parallelism": false, "qtime_dist_function": "resourceallocation.urbsense.urbsense.qtime(period_seconds=8)" },
            "GW": { "type": "router" },
            "CN": { "type": "host", "cpu_ghz": 4, "ram_gb": "inf", "infinite_parallelism": false, "qtime_dist_function": "resourceallocation.urbsense.urbsense.qtime(period_seconds=8)" }
        },

        "link_classes": {
            "WLAN": { "type": "constant", "data": 4 },
            "MAN": { "type": "constant", "data": 1 },
            "WAN": { "type": "constant", "data": 200 }
        },

        "network": [
            { "type": "wireless_unidir", "link_class": "WLAN", "data": { "set_a": [ "A0", "A1", "A2", "A3", "A4", "A5", "A6", "A7" ], "set_b": [ "AP0", "AP1", "AP2", "AP3"], "prob_matrix": "resourceallocation.urbsense.urbsense.compute_coverage_matrix(number_of_aps=4)" } },
            { "type": "star_bidir", "link_class": "MAN", "data": { "center": "GW", "set": [ "AP0", "AP1", "AP2", "AP3"] } },
            { "type": "direct_unidir", "link_class": "WAN", "data": [ "GW", "CN" ] }
        ]
    }
}