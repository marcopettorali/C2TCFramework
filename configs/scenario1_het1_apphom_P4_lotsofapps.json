            "CL": { "type": "file", "data": "datasets/cloud/nach_20.json" }
        },

        "network": [
            { "type": "wireless_unidir", "link_class": "TSCH", "data": { "set_a": [ "P0", "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", "P9", "P10", "P11", "P12", "P13", "P14", "P15", "P16", "P17" ], "set_b": [ "BR0", "BR1", "BR2", "BR3", "BR4", "BR5" ], "prob_matrix": "resourceallocation.compute_brcoverage_matrix.compute_brcoverage_matrix(channel_model='mobile6tisch-3.json')" } },
            { "type": "star_bidir", "link_class": "BB", "data": { "center": "GW", "set": [ "BR0", "BR1", "BR2", "BR3", "BR4", "BR5" ] } },
            { "type": "direct_unidir", "link_class": "CL", "data": [ "GW", "CN" ] }
