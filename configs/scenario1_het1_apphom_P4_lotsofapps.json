            "P17": { "type": "process" },
            "BR0": { "type": "host", "cpu_ghz": 5, "ram_gb": 8, "infinite_parallelism": false, "qtime_dist_function": "resourceallocation.tsch.sddu_qtime.qtime(g=4)" },
            "BR1": { "type": "host", "cpu_ghz": 5, "ram_gb": 8, "infinite_parallelism": false, "qtime_dist_function": "resourceallocation.tsch.sddu_qtime.qtime(g=4)" },
            "BR2": { "type": "host", "cpu_ghz": 3, "ram_gb": 8, "infinite_parallelism": false, "qtime_dist_function": "resourceallocation.tsch.sddu_qtime.qtime(g=4)" },
            "BR3": { "type": "host", "cpu_ghz": 3, "ram_gb": 8, "infinite_parallelism": false, "qtime_dist_function": "resourceallocation.tsch.sddu_qtime.qtime(g=4)" },
