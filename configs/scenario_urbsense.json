{
    "environment": "environments/env1_urbsense.json",
    "deployment": "deployments/env1_urbsense.json",

    "applications_import": "apps_urbsense.json",

    "processes_array": {
        "name": [ "A0", "A1", "A2", "A3", "A4", "A5", "A6", "A7" ],
        "application": [ "A0", "A1", "A2", "A3", "A4", "A5", "A6", "A7" ],
        "mns": [ 1, 1, 1, 1, 1, 1, 1, 1 ],
        "max_delay_ms": [ 200, 500, 1000, 1500, 2000, 4000, 6000, 8000 ],
        "min_reliability": [ 0, 0, 0, 0, 0, 0, 0, 0 ],
        "aoi": [
            { "type": "circle", "data": [ [ 100,100 ], 10000 ] },
            { "type": "circle", "data": [ [ 100,100 ], 10000 ] },
            { "type": "circle", "data": [ [ 100,100 ], 10000 ] },
            { "type": "circle", "data": [ [ 100,100 ], 10000 ] },
            { "type": "circle", "data": [ [ 100,100 ], 10000 ] },
            { "type": "circle", "data": [ [ 100,100 ], 10000 ] },
            { "type": "circle", "data": [ [ 100,100 ], 10000 ] },
            { "type": "circle", "data": [ [ 100,100 ], 10000 ] }
        ]
    },

    "topology": {
        "agents": {
            "P0": { "type": "process" },
            "P1": { "type": "process" },
            "P2": { "type": "process" },
            "P3": { "type": "process" },
            "P4": { "type": "process" },
            "P5": { "type": "process" },
            "P6": { "type": "process" },
            "P7": { "type": "process" },
            "BR0": { "type": "host", "cpu_ghz": 1, "ram_gb": "inf", "infinite_parallelism": false, "qtime_dist_function": "resourceallocation.urbsense.urbsense.qtime(period=8)" },
            "BR1": { "type": "host", "cpu_ghz": 1, "ram_gb": "inf", "infinite_parallelism": false, "qtime_dist_function": "resourceallocation.urbsense.urbsense.qtime(period=8)" },
            "BR2": { "type": "host", "cpu_ghz": 1, "ram_gb": "inf", "infinite_parallelism": false, "qtime_dist_function": "resourceallocation.urbsense.urbsense.qtime(period=8)" },
            "BR3": { "type": "host", "cpu_ghz": 1, "ram_gb": "inf", "infinite_parallelism": false, "qtime_dist_function": "resourceallocation.urbsense.urbsense.qtime(period=8)" },
            "GW": { "type": "router" },
            "CN": { "type": "host", "cpu_ghz": 4, "ram_gb": "inf", "infinite_parallelism": false, "qtime_dist_function": "resourceallocation.urbsense.urbsense.qtime(period=8)" }
        },

        "link_classes": {
            "WLAN": { "type": "constant", "data": 4 },
            "MAN": { "type": "constant", "data": 1 },
            "WAN": { "type": "constant", "data": 200 }
        },

        "network": [
            { "type": "wireless_unidir", "link_class": "WLAN", "data": { "set_a": [ "P0", "P1", "P2", "P3", "P4", "P5", "P6", "P7" ], "set_b": [ "BR0", "BR1", "BR2", "BR3", "BR4", "BR5" ], "prob_matrix": "resourceallocation.urbsense.urbsense.compute_brcoverage_matrix(number_of_aps=4)" } },
            { "type": "star_bidir", "link_class": "MAN", "data": { "center": "GW", "set": [ "BR0", "BR1", "BR2", "BR3", "BR4", "BR5" ] } },
            { "type": "direct_unidir", "link_class": "WAN", "data": [ "GW", "CN" ] }
        ]
    }
}